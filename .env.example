# Set this in your shell. The CLI does not automatically read .env files.
STICKERWU_IMAGEGEN_API_KEY=replace-with-your-own-key
STICKERWU_IMAGEGEN_BASE_URL=https://apis.vvvcode.com/v1
# Legacy VVVCODE_API_KEY and VVVCODE_BASE_URL still work.
# Explicit --profile NAME uses only that profile, ignoring environment connections.
